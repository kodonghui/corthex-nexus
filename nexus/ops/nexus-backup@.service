[Unit]
Description=Verified NEXUS %i SQLite backup
After=nexus@%i.service

[Service]
Type=oneshot
User=nexus-%i
Group=nexus-%i
EnvironmentFile=/etc/nexus/%i.env
ExecStart=/usr/bin/node /opt/nexus/%i/current/nexus/tools/database.js backup --database ${NEXUS_DATABASE} --directory /var/lib/nexus-%i/backups --reason daily
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nexus-%i
