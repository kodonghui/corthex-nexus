[Unit]
Description=NEXUS %i outbound Tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexus-tunnel
Group=nexus-tunnel
ExecStart=/usr/local/bin/cloudflared --config /etc/nexus/%i-tunnel.yml tunnel run
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M

[Install]
WantedBy=multi-user.target
