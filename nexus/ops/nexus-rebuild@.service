[Unit]
Description=NEXUS %i rebuild candidate
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexus-rebuild-%i
Group=nexus-rebuild-%i
EnvironmentFile=/etc/nexus/rebuild-%i.env
WorkingDirectory=/opt/nexus/rebuild-%i/current
ExecStart=/usr/bin/node /opt/nexus/rebuild-%i/current/nexus/src/rebuild-node.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=40
UMask=0077
StateDirectory=nexus-rebuild-%i
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nexus-rebuild-%i
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LimitNOFILE=4096
MemoryMax=512M

[Install]
WantedBy=multi-user.target
