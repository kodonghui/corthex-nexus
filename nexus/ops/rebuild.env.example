# Copy to an operator-managed owner-only environment file.
NEXUS_REBUILD_PORT=8788
NEXUS_REBUILD_DATABASE=/var/lib/nexus-rebuild-candidate/rebuild.sqlite
NEXUS_REBUILD_RELEASE_COMMIT=REPLACE_WITH_EXACT_MAIN_COMMIT
NEXUS_ORIGIN=https://nexus-candidate.example.test
NEXUS_LANGUAGE=en
# Register the exact HTTPS origin with /api/v2/auth/callback at your provider.
# NEXUS_OIDC_ISSUER=https://oidc.example.test
# NEXUS_OIDC_CLIENT_ID=ADMIN_REGISTERED_CLIENT
# NEXUS_OIDC_CLIENT_SECRET=
# NEXUS_OIDC_ATTEMPT_KEY=
# NEXUS_GITHUB_READ_TOKEN=
