[Unit]
Description=NEXUS %i standalone server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexus-%i
Group=nexus-%i
EnvironmentFile=/etc/nexus/%i.env
WorkingDirectory=/opt/nexus/%i/current
ExecStart=/usr/bin/node /opt/nexus/%i/current/nexus/src/node.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=40
UMask=0077
StateDirectory=nexus-%i
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nexus-%i
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LimitNOFILE=4096
MemoryMax=512M

[Install]
WantedBy=multi-user.target
