# Operator-only file: copy outside the repository with mode 0600.
# Node 24 LTS. Keep real origin/team/audience values outside Git.
NEXUS_PORT=8787
NEXUS_DATABASE=/var/lib/nexus-dev/nexus.sqlite
NEXUS_ORIGIN=https://nexus.example.com
NEXUS_LANGUAGE=en
ACCESS_TEAM_DOMAIN=team.cloudflareaccess.com
ACCESS_AUD=REPLACE_WITH_APPLICATION_AUDIENCE
# The backup's copy on another machine (REQ-291): rclone's remote and folder, set up as the guide says.
# NEXUS_BACKUP_REMOTE=<remote>:nexus-backups
