{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "corthex-nexus",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // Change this to the address you chose, on a domain in your Cloudflare account.
  "routes": [{ "pattern": "nexus.example.com", "custom_domain": true }],
  // Only the address above serves the hub: no workers.dev or preview addresses.
  "workers_dev": false,
  "preview_urls": false,
  // Wrangler creates the database on the first deploy and, run in a terminal,
  // writes its ID here; later deploys keep using the database either way.
  "d1_databases": [{ "binding": "DB", "database_name": "corthex-nexus" }],
  // The page template is bundled as text. Do not add static assets: a Worker
  // with assets does not receive the Access check (ctx.access) it relies on.
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "vars": {
    // "ko" for a Korean page, otherwise English.
    "NEXUS_LANGUAGE": "en",
    // Required: set this through `wrangler secret put ACCESS_AUD` rather than
    // committing an application's value. Empty means fail closed.
    // Also add ACCESS_TEAM_DOMAIN to your local vars, for example
    // "ACCESS_TEAM_DOMAIN": "your-team.cloudflareaccess.com".
    "ACCESS_AUD": ""
  }
}
